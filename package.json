{
  "name": "tree-sitter-zz",
  "version": "0.1.0",
  "description": "Tree-sitter grammar for the ZZ programming language",
  "keywords": ["tree-sitter", "zz", "parser"],
  "author": "zaidejjo",
  "license": "MIT",
  "repository": "https://github.com/zaidejjo/tree-sitter-zz",
  "scripts": {
    "generate": "tree-sitter generate",
    "test": "tree-sitter test",
    "parse": "tree-sitter parse"
  },
  "devDependencies": {
    "tree-sitter-cli": "^0.27.0"
  },
  "tree-sitter": [
    {
      "file-types": ["zz"],
      "highlights": "queries/highlights.scm",
      "folds": "queries/folds.scm",
      "indents": "queries/indents.scm",
      "injection-regex": "^zz$"
    }
  ]
}
